# Supabase (server-side only — never expose service role to client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT session signing (min 32 random characters)
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: restrict CORS to your frontend origin in production
# CLIENT_ORIGIN=https://your-app.vercel.app

# Optional: API base for client when not same-origin (usually leave empty)
# VITE_API_BASE=
